# Environment variables example for basic-api
# Copy this file to .env and fill out the real values (do NOT commit .env)

# Database configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/basic_api

# JWT configuration. The secret must be at least 32 bytes; the app refuses to
# start with a shorter one. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_value_of_32_bytes_or_more
# One of HS256, HS384, HS512
JWT_ALGORITHM=HS256
# Default token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Longest lifetime a client may request at login via ?expires_delta= (default 7 days)
JWT_MAX_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Bcrypt cost; 12 is the minimum the app accepts
BCRYPT_ROUNDS=12

# Security
API_KEY=your-secret-api-key-here

# Notes:
# - Keep real secrets out of source control. Use your platform's secret manager for production.
# - Generate JWT_SECRET_KEY with a secure random generator, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
