# Environment variables example for basic-api
# Copy this file to .env and fill out the real values (do NOT commit .env)

# JWT configuration
JWT_SECRET_KEY=replace_with_a_secure_random_value
JWT_ALGORITHM=HS256
# Token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin credentials (local/dev only). Use real secrets in your deployment environment
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_admin_password_here  # (optional) if your app expects a password env var

# Notes:
# - Keep real secrets out of source control. Use your platform's secret manager for production.
# - Generate JWT_SECRET_KEY with a secure random generator, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
